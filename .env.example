# Origin of the Boppi Cloud control plane. No path, no trailing slash.
# Primary CTAs open ${VITE_APP_URL}/signup. Sign-in opens ${VITE_APP_URL}/login.
# If this is unset or blank, the site uses https://app.boppi.io.
# Copy to .env.local for local dev. On Vercel, set it on project boppi-website
# and redeploy; this repository does not change Vercel settings.
VITE_APP_URL=https://app.boppi.io
